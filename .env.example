# Copy this file to ".env" and fill in your key.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here

# AI model names (change here if Google renames them)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# If the main model is overloaded (503) or retired, the app quietly tries these, in order.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# How many AI requests may run at once (notes sections, long-document condensing, scanned-page reading).
# 3 is safe on a free key. Try 4-5 if you never see "busy" messages; use 2 if you do.
GEMINI_PARALLEL=3

# Speech-to-text model: tiny | base | small | medium | large-v3
# CPU laptop: "small" (good speed/accuracy). NVIDIA GPU: "medium" or "large-v3".
WHISPER_MODEL=small
# 1 = fastest, 5 = most accurate
WHISPER_BEAM_SIZE=1

# Extract a "key facts" list after each upload (1 = yes, 0 = no)
AUTO_FACTS=1

# ---- Video / audio ----
# auto   = clips up to LOCAL_MAX_MINUTES run on this computer, longer lectures use Gemini (minutes instead of hours)
# gemini = always use Gemini (fast, uses your API quota, audio is sent to Google)
# local  = always on this computer (private, but slow without an NVIDIA GPU)
TRANSCRIBE_MODE=auto
LOCAL_MAX_MINUTES=5
# Each Gemini request carries about this much audio (inline limit is 20 MB per request)
CLOUD_CHUNK_MINUTES=8
# Background noise filter in "auto" is only used for clips up to this long
DENOISE_AUTO_MAX_MINUTES=10
# CPU threads for local Whisper (default: all cores; the library alone would use only 4)
# WHISPER_THREADS=8
